#!/usr/bin/env bash
# Cut a clip out of a YouTube video or a local video file.
#
# Local files are cut directly with ffmpeg. For URLs it tries yt-dlp --download-sections first. That fails (or writes an empty file) for
# livestreams YouTube is still processing ("post_live"), so on failure it downloads the
# full stream with yt-dlp's native downloader and cuts the clip locally with ffmpeg.

set -euo pipefail

VERSION=0.2.0

usage() {
  cat <<'USAGE'
Usage: yt-clip <url|file> <start> <end> [output-name]

  url|file     a YouTube (or any yt-dlp supported) URL, or a local video file
  start/end    HH:MM:SS, MM:SS or seconds
  output-name  without extension (default: clip-<start>-<end>)

Examples:
  yt-clip "https://youtu.be/eJmpTKQHjP0" 00:34:00 00:38:30 spiritual-talk-clip
  yt-clip "https://youtu.be/eJmpTKQHjP0" 34:00 38:30
  yt-clip ~/Movies/talk.mkv 1:02:10 1:05:00 talk-part2
USAGE
}

case "${1:-}" in
  -h | --help) usage; exit 0 ;;
  -v | --version | version) echo "yt-clip $VERSION"; exit 0 ;;
esac

if [[ $# -lt 3 ]]; then
  usage >&2
  exit 1
fi

url=$1 start=$2 end=$3
name=${4:-clip-${start//:/}-${end//:/}}
out="$name.mp4"

local_file=false
if [[ -f "$url" ]]; then
  local_file=true
  deps=(ffmpeg ffprobe)
elif [[ "$url" =~ ^[a-zA-Z][a-zA-Z0-9+.-]*:// ]]; then
  deps=(yt-dlp ffmpeg ffprobe)
else
  echo "Not a URL and no such file: $url" >&2
  exit 1
fi

for cmd in "${deps[@]}"; do
  command -v "$cmd" >/dev/null || { echo "Missing dependency: $cmd (brew install $cmd)" >&2; exit 1; }
done

to_seconds() {
  local t=$1 s=0 part
  [[ "$t" =~ ^[0-9]+(:[0-9]+){0,2}$ ]] || { echo "Invalid time: $t" >&2; return 1; }
  IFS=: read -ra parts <<<"$t"
  for part in "${parts[@]}"; do s=$((s * 60 + 10#$part)); done
  echo "$s"
}

start_s=$(to_seconds "$start")
end_s=$(to_seconds "$end")
duration=$((end_s - start_s))
((duration > 0)) || { echo "End must be after start" >&2; exit 1; }

# A clip is valid if its duration is within 2s of what we asked for.
valid_clip() {
  local d
  d=$(ffprobe -v error -show_entries format=duration -of default=nw=1:nk=1 "$1" 2>/dev/null || true)
  [[ "$d" =~ ^[0-9.]+$ ]] && awk -v d="$d" -v want="$duration" 'BEGIN { exit !(d > want - 2 && d < want + 2) }'
}

cut_clip() {
  ffmpeg -hide_banner -loglevel error -y \
    -ss "$start_s" -i "$1" -t "$duration" \
    -map 0:v:0 -map '0:a:0?' \
    -c:v libx264 -preset veryfast -crf 20 -c:a aac -b:a 160k -movflags +faststart \
    "$out"
}

if $local_file; then
  in_abs=$(cd "$(dirname "$url")" && pwd)/$(basename "$url")
  out_abs=$(pwd)/$out
  [[ "$in_abs" != "$out_abs" ]] || { echo "Output would overwrite the input; pass a different output-name" >&2; exit 1; }

  src_d=$(ffprobe -v error -show_entries format=duration -of default=nw=1:nk=1 "$url" 2>/dev/null || true)
  [[ "$src_d" =~ ^[0-9.]+$ ]] || { echo "Not a readable video: $url" >&2; exit 1; }
  awk -v d="$src_d" -v e="$end_s" 'BEGIN { exit !(e <= d + 1) }' ||
    { echo "End ($end) is past the end of the video (${src_d%.*}s)" >&2; exit 1; }

  echo "==> Cutting $url ($start -> $end)"
  cut_clip "$url"
  valid_clip "$out" || { echo "Clip looks wrong; check $out" >&2; exit 1; }
  echo "==> Done: $out"
  exit 0
fi

rm -f "$out"

echo "==> Trying direct section download ($start -> $end)"
if yt-dlp --force-overwrites --force-keyframes-at-cuts \
     --download-sections "*$start-$end" \
     --merge-output-format mp4 -o "$name.%(ext)s" "$url" && valid_clip "$out"; then
  echo "==> Done: $out"
  exit 0
fi

echo "==> Direct section download failed; downloading full stream and cutting locally"
rm -f "$out"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

yt-dlp -N 8 -f "bv*+ba/b" --merge-output-format mp4 -o "$tmp/full.%(ext)s" "$url"

cut_clip "$tmp/full.mp4"

valid_clip "$out" || { echo "Clip looks wrong; check $out" >&2; exit 1; }
echo "==> Done: $out"
